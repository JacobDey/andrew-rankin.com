  {"eval": "(async () => { const c = document.createElement('canvas'); c.width = 256; c.height = 320; const g = c.getContext('2d'); const gr = g.createLinearGradient(0, 0, 256, 0); gr.addColorStop(0, '#000'); gr.addColorStop(1, '#fff'); g.fillStyle = gr; g.fillRect(0, 0, 256, 320); g.fillStyle = '#fff'; g.beginPath(); g.arc(128, 120, 60, 0, 7); g.fill(); g.fillStyle = '#111'; g.font = 'bold 80px sans-serif'; g.fillText('ARK', 40, 280); return __game.loadPNG(c.toDataURL()) })()"},
